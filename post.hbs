{{!< default}}

{{#post}}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
        {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "{{@site.url}}/"
        },
        {{#if primary_tag}}
        {
            "@type": "ListItem",
            "position": 2,
            "name": "{{primary_tag.name}}",
            "item": "{{#primary_tag}}{{url absolute="true"}}{{/primary_tag}}"
        },
        {
            "@type": "ListItem",
            "position": 3,
            "name": "{{title}}",
            "item": "{{url absolute="true"}}"
        }
        {{else}}
        {
            "@type": "ListItem",
            "position": 2,
            "name": "所有文章",
            "item": "{{@site.url}}/posts/"
        },
        {
            "@type": "ListItem",
            "position": 3,
            "name": "{{title}}",
            "item": "{{url absolute="true"}}"
        }
        {{/if}}
    ]
}
</script>
{{/post}}

<main class="site-main">

    {{#post}}
        {{> "content" width="wide"}}
    {{/post}}

    {{!-- Post CTA --}}
    <section class="post-cta gh-canvas">
        <h3>想學更多？</h3>
        <p>訂閱電子報，每週收到最新的 AI 實戰教學。</p>
        {{#if @site.members_enabled}}
            {{#unless @member}}
                <form class="form-wrapper" data-members-form>
                    <input class="auth-email" type="email" name="email" data-members-email placeholder="輸入你的 Email" required="true">
                    <button class="form-button" type="submit" aria-label="Subscribe">
                        <span class="default">訂閱</span>
                        <span class="loader">{{> "icons/loader"}}</span>
                        <span class="success">已送出</span>
                    </button>
                </form>
            {{/unless}}
        {{/if}}
    </section>

    {{#if @custom.show_related_posts}}
        {{> "related-posts"}}
    {{/if}}

    {{#post}}
        {{> "comments"}}
    {{/post}}

</main>
<article class="category-post {{post_class}}">
    <a class="category-post-link" href="{{url}}" aria-label="{{title}}">
        <div class="category-post-image u-placeholder rectangle">
            {{#if feature_image}}
                <img
                    src="{{img_url feature_image size="m"}}"
                    alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                    loading="lazy"
                >
            {{/if}}
        </div>
        <div class="category-post-content">
            <h3 class="category-post-title">{{title}}</h3>
            {{#if excerpt}}
                <p class="category-post-excerpt">{{excerpt words="18"}}</p>
            {{/if}}
            <time class="category-post-date" datetime="{{date format="YYYY-MM-DD"}}">
                {{date published_at format="DD MMM YYYY"}}
            </time>
        </div>
    </a>
</article>

{{!< default}}
{{!--
Custom page template for displaying services.
Fetches posts tagged with "service" and displays them in an alternating left/right layout.
Select this template from Ghost admin when editing a page.
--}}

<main class="site-main">

    {{#post}}
        {{#match @page.show_title_and_feature_image}}
            <header class="single-header gh-canvas">
                <h1 class="single-title">{{title}}</h1>

                {{#if custom_excerpt}}
                    <div class="single-excerpt">
                        {{custom_excerpt}}
                    </div>
                {{/if}}

                {{#if feature_image}}
                    <figure class="single-media kg-width-wide">
                        <img
                            srcset="{{> "srcset"}}"
                            sizes="(min-width: 1023px) 920px, calc(90vw)"
                            src="{{img_url feature_image size="l"}}"
                            alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                        >
                        {{#if feature_image_caption}}
                            <figcaption>{{feature_image_caption}}</figcaption>
                        {{/if}}
                    </figure>
                {{/if}}
            </header>
        {{/match}}

        {{#if html}}
            <div class="single-content gh-content gh-canvas">
                {{content}}
            </div>
        {{/if}}
    {{/post}}

    {{!-- Services list section --}}
    <div class="services-feed gh-canvas">
        {{#get "posts" filter="tag:service" limit="all" include="tags,authors"}}
            {{#foreach posts}}
                <article class="service-item {{post_class}}">
                    <div class="service-image">
                        {{#if feature_image}}
                            <img
                                srcset="{{> "srcset"}}"
                                sizes="(min-width: 768px) 45vw, 90vw"
                                src="{{img_url feature_image size="l"}}"
                                alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                                loading="lazy"
                            >
                        {{/if}}
                    </div>
                    <div class="service-content">
                        <h2 class="service-title">{{title}}</h2>
                        {{#if excerpt}}
                            <p class="service-description">{{excerpt}}</p>
                        {{/if}}
                        <a class="service-link" href="{{url}}">
                            Learn More
                            {{> "icons/chevron-right"}}
                        </a>
                    </div>
                </article>
            {{/foreach}}
        {{else}}
            <div class="no-services">
                <p>No services found. Add posts with the "service" tag to display them here.</p>
            </div>
        {{/get}}
    </div>

</main>

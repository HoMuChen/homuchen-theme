{{!< default}}
{{!--
This is a custom page template for displaying all blog posts grouped by category.
It can be selected from the Ghost admin panel when editing a page.
--}}

<main class="site-main">

    {{#post}}
        {{!-- Respect "Show title and feature image" setting from admin panel --}}
        {{#match @page.show_title_and_feature_image}}
            <header class="single-header gh-canvas">
                <h1 class="single-title">{{title}}</h1>

                {{#if custom_excerpt}}
                    <div class="single-excerpt">
                        {{custom_excerpt}}
                    </div>
                {{/if}}

                {{#if feature_image}}
                    <figure class="single-media kg-width-wide">
                        <img
                            srcset="{{> "srcset"}}"
                            sizes="(min-width: 1023px) 920px, calc(90vw)"
                            src="{{img_url feature_image size="l"}}"
                            alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                        >
                        {{#if feature_image_caption}}
                            <figcaption>{{feature_image_caption}}</figcaption>
                        {{/if}}
                    </figure>
                {{/if}}
            </header>
        {{/match}}

        {{!-- Optional page content --}}
        {{#if html}}
            <div class="single-content gh-content gh-canvas">
                {{content}}
            </div>
        {{/if}}
    {{/post}}

    {{!-- Categories with post previews --}}
    {{#get "tags" limit="all" filter="visibility:public+slug:-service" order="name asc"}}
        {{#foreach tags}}
            {{#get "posts" filter="primary_tag:{{slug}}" limit="3" include="tags,authors"}}
                {{#if posts}}
                    <section class="blog-category gh-canvas">
                        <header class="blog-category-header">
                            <div class="blog-category-header-left">
                                <a href="{{../url}}" class="blog-category-name">{{../name}}</a>
                                {{#if ../description}}
                                    <p class="blog-category-desc">{{../description}}</p>
                                {{/if}}
                            </div>
                            <a href="{{../url}}" class="blog-category-view-all">查看全部 →</a>
                        </header>
                        <div class="blog-category-posts">
                            {{#foreach posts}}
                                {{> "category-post"}}
                            {{/foreach}}
                        </div>
                    </section>
                {{/if}}
            {{/get}}
        {{/foreach}}
    {{/get}}

</main>
